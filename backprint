<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Betprint</title>
<!-- Your existing meta tags omitted for brevity -->
<style>
@import url("https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400&display=swap");
* {
  font-family: "Roboto", arial;
}

body {
  background-color: #1a2852;
  color: white;
  display: flex;
  margin: 0;
  height: 100vh;
}

/* Side panel styles */
.side-panel {
  position: fixed;
  top: 0;
  left: 0;
  width: 250px;
  height: 100vh;
  background-color: #656770;
  display: flex;
  flex-direction: column;
  padding: 20px;
  border-right: 1px solid #444;
  box-sizing: border-box;
}

.side-panel img {
  width: 50px;
  height: 50px;
  margin-right: 10px;
  user-select: none;
}

.side-panel h2 {
  font-weight: bold;
  margin-bottom: 40px;
  user-select: none;
}

.option {
  margin: 10px 0;
  font-size: 18px;
  cursor: pointer;
  padding: 10px;
  border-radius: 8px;
  transition: background 0.2s;
}
.option:hover {
  background-color: #062a73;
}
.option.active {
  background-color: #8ab4f8;
  color: blue;
}

/* Main content styles */
.main-content {
  margin-left: 250px; /* same as side panel width */
  padding: 20px;
  flex: 1;
  overflow-y: auto;
}

/* Tabs styles */
#printer-tab, #about-tab, #settings-tab {
  display: none;
}
#printer-tab.active, #about-tab.active, #settings-tab.active {
  display: block;
}

/* Extension container styles */
.extension-container {
  background: #3763e6;
  padding: 10px;
  border-radius: 10px;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.extension-info {
  display: flex;
  align-items: center;
}
.extension-info img {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  margin-right: 10px;
}
.extension-name {
  font-size: 13px;
}
.extension-id {
  font-size: 11px;
  color: #c4c7c5;
  margin-left: 8px;
}

/* Button style */
button {
  background: transparent;
  color: #9dbae9;
  border: 1px solid #047db7;
  border-radius: 20px;
  padding: 7px 10px;
  cursor: pointer;
  transition: background 0.2s;
}
button:hover {
  background: #38393b;
}

/* Other styles omitted for brevity */
</style>
</head>
<body>
<!-- Side Panel -->
<div class="side-panel">
  <div style="display:flex; align-items:center;">
    <img src="https://raw.githubusercontent.com/Blobby-Boi/ExtPrint3r/refs/heads/main/icon.png" alt="Icon" />
    <h2>Betprint</h2>
  </div>
  <div class="option active" data-name="printer-tab">The Exploit</div>
  <div class="option" data-name="settings-tab">Settings</div>
  <div class="option" data-name="about-tab">About</div>
  <div style="border-top:1px solid #444; margin-top:10px; padding-top:10px; width:100%;"></div>
  <p style="text-align:center; margin-left:-10px;">Made by <a href="https://github.com/blookethackerlol2/" target="_blank" style="color:#9dbae9;">someone</a></p>
</div>

<!-- Main Content -->
<div class="main-content">
  <!-- The Exploit Tab -->
  <div id="printer-tab" class="tab active">
    <h3>All Extensions</h3>
    <div id="div-container"></div>
  </div>
  <!-- About Tab -->
  <div id="about-tab" class="tab">
    <h2>About Betprint</h2>
    <p>Betprint is an exploit created by <a href="https://github.com/blookethackerlol2/" target="_blank">someone</a> with the goal of being the successor to Extprint3r...</p>
  </div>
  <!-- Settings Tab -->
  <div id="settings-tab" class="tab">
    <h2>Settings</h2>
    <label for="developer-mode">Developer Mode</label>
    <input id="developer-mode" type="checkbox" />
    <br />
    <label for="iframe-count">Amount of iframes</label>
    <input type="range" min="100" max="100000" value="10000" step="500" id="iframe-count" />
    <span id="iframe-count-display">10000</span>
    <br />
    <button id="add-ext" style="margin-top:20px;">Temporarily Add Extension To List</button>
  </div>
</div>

<!-- Scripts -->
<script>
  // Helper function to switch tabs
  const options = document.querySelectorAll('.option');
  options.forEach(opt => {
    opt.addEventListener('click', () => {
      options.forEach(o => o.classList.remove('active'));
      opt.classList.add('active');

      const name = opt.getAttribute('data-name');
      document.querySelectorAll('.tab').forEach(tab => {
        tab.classList.remove('active');
        if (tab.id === name) {
          tab.classList.add('active');
        }
      });
    });
  });

  // Example: Fetch extensions and populate 'div-container'
  async function populateExtensions() {
    const container = document.getElementById('div-container');
    container.innerHTML = "Loading extensions...";

    // Since `chrome.management.getAll()` only works in extensions, simulate data here
    const extensions = [
      {
        name: "Sample Extension 1",
        id: "abc123",
        enabled: true,
        icons: [{url: "https://via.placeholder.com/40"}],
        permissions: ["web_accessible_resources"]
      },
      {
        name: "Sample Extension 2",
        id: "def456",
        enabled: false,
        icons: [{url: "https://via.placeholder.com/40"}],
        permissions: []
      }
    ];

    container.innerHTML = "";
    extensions.forEach(ext => {
      if (ext.enabled && ext.permissions.includes("web_accessible_resources")) {
        const div = document.createElement('div');
        div.className = 'extension-container';

        div.innerHTML = `
          <div class="extension-info">
            <img src="${ext.icons ? ext.icons[0].url : 'https://via.placeholder.com/40'}" alt="${ext.name}">
            <div>
              <div class="extension-name">${ext.name}</div>
              <div class="extension-id">${ext.id}</div>
            </div>
          </div>
        `;
        container.appendChild(div);
      }
    });
  }

  // Call on load
  window.onload = populateExtensions;

  // Example: Add extension button click
  document.getElementById('add-ext').addEventListener('click', () => {
    alert('This would add a temporary extension (simulate)');
  });

  // Range input display
  const rangeInput = document.getElementById('iframe-count');
  const rangeDisplay = document.getElementById('iframe-count-display');

  rangeInput.addEventListener('input', () => {
    rangeDisplay.textContent = rangeInput.value;
  });
</script>
</body>
</html>
